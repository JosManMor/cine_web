FROM php:8.3.36-fpm-alpine

RUN apk add --no-cache \
    curl git icu-dev libxml2-dev libzip-dev oniguruma-dev unzip \
  && docker-php-ext-install \
    bcmath intl mbstring pcntl pdo_mysql pdo_sqlite xml zip

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer

WORKDIR /var/www

USER www-data
