# Cron jobs del sistema Cine Sendera
# Instalación: sudo crontab -u root scripts/cine.cron
#           o: sudo cp scripts/cine.cron /etc/cron.d/cine

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Backup — cada día a las 2:00 AM si hay >15% de disco libre
0 2 * * * root /opt/cine_sendera/scripts/backup.sh

# El reinicio diario de la demo (demo:reset) lo ejecuta el contenedor
# scheduler de docker-compose.prod.yml, no este archivo.
