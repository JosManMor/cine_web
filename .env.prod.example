# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=CineSystem
APP_ENV=production
APP_KEY=                          # php artisan key:generate lo genera al arrancar
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # Solo errores en producción

# ── Database — Laravel ────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql                     # Nombre del servicio en la red interna
DB_PORT=3306
DB_DATABASE=cine_db
DB_USERNAME=cine_user
DB_PASSWORD=cambia_esta_password_segura

# ── Database — MySQL (imagen oficial lee estas variables directamente) ─────────
# Deben coincidir con los valores DB_* de arriba.
MYSQL_DATABASE=cine_db
MYSQL_USER=cine_user
MYSQL_PASSWORD=cambia_esta_password_segura
MYSQL_ROOT_PASSWORD=cambia_esta_root_password

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Broadcasting / Queue / Cache ──────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Redis (desactivado en simulación) ────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Memcached ─────────────────────────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1

# ── Mail (apunta a servidor SMTP real, no a Mailpit) ─────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=correo@tudominio.com
MAIL_PASSWORD=password_real
MAIL_FROM_ADDRESS=noreply@cinesendera.com
MAIL_FROM_NAME=CineSendera

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=CineSystem

# ── Swagger (desactivado en producción) ───────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=false
