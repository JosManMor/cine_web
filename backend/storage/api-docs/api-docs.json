{
    "openapi": "3.0.0",
    "info": {
        "title": "Cine Sendera API",
        "description": "API REST para el sistema de gestión de cine Cine Sendera. Autenticación vía Bearer Token (Sanctum).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Servidor principal"
        }
    ],
    "paths": {
        "/admin/metrics": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Métricas generales del panel de administración",
                "description": "Devuelve tickets vendidos, ventas del día, usuarios registrados, película más vendida y ventas por día de la semana.",
                "operationId": "cbeb56339adcb1554c48f1c3446a68d4",
                "responses": {
                    "200": {
                        "description": "Métricas obtenidas correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "tickets_sold": {
                                            "type": "integer",
                                            "example": 247
                                        },
                                        "daily_sales": {
                                            "type": "number",
                                            "format": "float",
                                            "example": 20995
                                        },
                                        "registered_users": {
                                            "type": "integer",
                                            "example": 1482
                                        },
                                        "top_movie": {
                                            "properties": {
                                                "title": {
                                                    "type": "string",
                                                    "example": "Inferno Nexus"
                                                },
                                                "tickets_sold": {
                                                    "type": "integer",
                                                    "example": 104
                                                }
                                            },
                                            "type": "object",
                                            "nullable": true
                                        },
                                        "weekly_sales": {
                                            "type": "array",
                                            "items": {
                                                "properties": {
                                                    "day": {
                                                        "type": "string",
                                                        "example": "Lun"
                                                    },
                                                    "value": {
                                                        "type": "integer",
                                                        "example": 42
                                                    }
                                                },
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Acceso denegado — no es admin"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/admin/activity": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Actividad reciente del sistema",
                "description": "Devuelve los últimos eventos del sistema (compras exitosas y pagos fallidos).",
                "operationId": "db6943f9c5c24bf9c59958df998a7277",
                "responses": {
                    "200": {
                        "description": "Lista de eventos recientes",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "type": {
                                                "type": "string",
                                                "example": "success",
                                                "enum": [
                                                    "success",
                                                    "error"
                                                ]
                                            },
                                            "message": {
                                                "type": "string",
                                                "example": "Compra exitosa — Inferno Nexus"
                                            },
                                            "time": {
                                                "type": "string",
                                                "example": "hace 2 min"
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Acceso denegado — no es admin"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/admin/rooms": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Estado actual de las salas",
                "description": "Devuelve el estado de cada sala activa: película, % ocupación, asientos disponibles y próxima función.",
                "operationId": "3cc9471da67f8a8e82e169cd976abf16",
                "responses": {
                    "200": {
                        "description": "Lista de salas con estado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "room": {
                                                "type": "string",
                                                "example": "Sala 1"
                                            },
                                            "status": {
                                                "type": "string",
                                                "example": "showing",
                                                "enum": [
                                                    "showing",
                                                    "upcoming",
                                                    "idle"
                                                ]
                                            },
                                            "current_movie": {
                                                "type": "string",
                                                "example": "Inferno Nexus",
                                                "nullable": true
                                            },
                                            "current_ends_at": {
                                                "type": "string",
                                                "format": "date-time",
                                                "example": "2025-07-25 16:18:00",
                                                "nullable": true
                                            },
                                            "next_movie": {
                                                "type": "string",
                                                "example": "Hollow Depths",
                                                "nullable": true
                                            },
                                            "next_start_time": {
                                                "type": "string",
                                                "format": "date-time",
                                                "example": "2025-07-25 18:00:00",
                                                "nullable": true
                                            },
                                            "occupancy_pct": {
                                                "type": "integer",
                                                "example": 87
                                            },
                                            "available_seats": {
                                                "type": "integer",
                                                "example": 16
                                            },
                                            "total_seats": {
                                                "type": "integer",
                                                "example": 120
                                            }
                                        },
                                        "type": "object"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    },
                    "403": {
                        "description": "Acceso denegado — no es admin"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/register": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Registro de usuario",
                "description": "Crea una cuenta nueva con rol 'client' y devuelve un Bearer Token. Envía un correo de verificación automáticamente.",
                "operationId": "f367ea894b2ac44a9607f8e0a9a03537",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Juan Pérez",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario registrado correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|abc123..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Inicio de sesión",
                "description": "Autentica al usuario y devuelve un Bearer Token. Rate limit: 5 intentos por minuto.",
                "operationId": "ec9c379d2a959de66404708dd4a9322d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Autenticación exitosa",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "2|xyz789..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciales incorrectas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Credenciales incorrectas."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cierre de sesión",
                "description": "Revoca el Bearer Token actual.",
                "operationId": "cc14526f9abd470d63047b1c05aef0c3",
                "responses": {
                    "200": {
                        "description": "Sesión cerrada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Sesión cerrada correctamente."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/email/verification-notification": {
            "post": {
                "tags": [
                    "Verificación de correo"
                ],
                "summary": "Reenviar correo de verificación",
                "description": "Envía un nuevo enlace firmado al correo del usuario autenticado. Rate limit: 6 por minuto.",
                "operationId": "2f359547288bf415a228a2a2dbb74a9d",
                "responses": {
                    "200": {
                        "description": "Correo enviado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Correo de verificación enviado."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "Correo ya verificado (sin cuerpo)"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/email/verify/{id}/{hash}": {
            "get": {
                "tags": [
                    "Verificación de correo"
                ],
                "summary": "Verificar correo electrónico",
                "description": "Valida el enlace firmado recibido por email y marca el correo como verificado.",
                "operationId": "74298087f7abdea2982e5a7ea970428f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del usuario",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "hash",
                        "in": "path",
                        "description": "SHA-1 del email",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "expires",
                        "in": "query",
                        "description": "Timestamp de expiración",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "signature",
                        "in": "query",
                        "description": "Firma HMAC",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Correo verificado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Correo verificado correctamente."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Firma inválida o expirada"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/movies": {
            "get": {
                "tags": [
                    "Cartelera"
                ],
                "summary": "Listar cartelera",
                "description": "Devuelve todas las películas con estado activo, ordenadas por título.",
                "operationId": "5ea1e205d16b53f29174a23fd2dc0aca",
                "responses": {
                    "200": {
                        "description": "Lista de películas activas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Movie"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/movies/{id}": {
            "get": {
                "tags": [
                    "Cartelera"
                ],
                "summary": "Detalle de película",
                "description": "Devuelve la película con sus funciones (solo status=open), salas y asientos disponibles calculados.",
                "operationId": "4705b96c2d4c7ae2c3d1138291da5b6d",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Película con funciones",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MovieDetail"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Película no encontrada"
                    }
                }
            }
        },
        "/purchases": {
            "post": {
                "tags": [
                    "Compras"
                ],
                "summary": "Crear compra",
                "description": "Reserva asientos y crea la compra en estado pending. El ticket_code se asigna cuando el pago se confirma.",
                "operationId": "b7e40bd94380c4c777ef68c5a37d1283",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "screening_id",
                                    "seats",
                                    "payment_method"
                                ],
                                "properties": {
                                    "screening_id": {
                                        "type": "integer",
                                        "example": 12
                                    },
                                    "seats": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "row": {
                                                    "type": "string",
                                                    "example": "A"
                                                },
                                                "seat_number": {
                                                    "type": "integer",
                                                    "example": 3
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "example": "card",
                                        "enum": [
                                            "cash",
                                            "card",
                                            "online"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Compra creada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string"
                                        },
                                        "purchase_id": {
                                            "type": "integer"
                                        },
                                        "payment_status": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Asiento ya reservado"
                    },
                    "422": {
                        "description": "Datos inválidos o función no disponible"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/tickets/{ticket_code}": {
            "get": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Ver ticket digital",
                "description": "Devuelve la información completa del ticket. El QR se genera en el cliente a partir del ticket_code.",
                "operationId": "9d429503a87557b1519ac3e936ccab7f",
                "parameters": [
                    {
                        "name": "ticket_code",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "SNDR-2025-7A3F"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Ticket encontrado"
                    },
                    "403": {
                        "description": "El ticket no pertenece al usuario autenticado"
                    },
                    "404": {
                        "description": "Ticket no encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/my-tickets": {
            "get": {
                "tags": [
                    "Tickets"
                ],
                "summary": "Listar mis tickets activos",
                "description": "Devuelve todos los tickets activos del usuario autenticado cuyo pago fue confirmado. Un ticket por asiento reservado.",
                "operationId": "e13b926d454ef13268915da1bf4f1628",
                "responses": {
                    "200": {
                        "description": "Lista de tickets activos"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/screenings/{id}": {
            "get": {
                "tags": [
                    "Cartelera"
                ],
                "summary": "Mapa de asientos de una función",
                "description": "Devuelve los datos de la sala y la lista de asientos ocupados para que el frontend construya el mapa interactivo.",
                "operationId": "7aeb7f89c24ade654cf36314eff53994",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Datos de la función con asientos ocupados"
                    },
                    "404": {
                        "description": "Función no encontrada"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Juan Pérez"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "juan@example.com"
                    },
                    "role": {
                        "type": "string",
                        "example": "client",
                        "enum": [
                            "admin",
                            "cashier",
                            "client"
                        ]
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "The name field is required."
                    },
                    "errors": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "Movie": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Inferno Nexus"
                    },
                    "genre": {
                        "type": "string",
                        "example": "Acción"
                    },
                    "duration_minutes": {
                        "type": "integer",
                        "example": 138
                    },
                    "rating": {
                        "type": "string",
                        "example": "PG-13"
                    },
                    "poster_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://cine-sendera.com/images/inferno-nexus.jpg"
                    },
                    "status": {
                        "type": "string",
                        "example": "active",
                        "enum": [
                            "active",
                            "inactive"
                        ]
                    }
                },
                "type": "object"
            },
            "Room": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Sala 1"
                    },
                    "total_seats": {
                        "type": "integer",
                        "example": 120
                    },
                    "available_seats": {
                        "type": "integer",
                        "example": 48
                    }
                },
                "type": "object"
            },
            "Screening": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 12
                    },
                    "start_time": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-07-25T14:00:00Z"
                    },
                    "format": {
                        "type": "string",
                        "example": "2D",
                        "enum": [
                            "2D",
                            "3D",
                            "IMAX"
                        ]
                    },
                    "language_type": {
                        "type": "string",
                        "example": "subtitled",
                        "enum": [
                            "dubbed",
                            "subtitled",
                            "original"
                        ]
                    },
                    "base_price": {
                        "type": "number",
                        "format": "float",
                        "example": 90
                    },
                    "status": {
                        "type": "string",
                        "example": "open",
                        "enum": [
                            "open",
                            "closed",
                            "cancelled"
                        ]
                    },
                    "room": {
                        "$ref": "#/components/schemas/Room"
                    }
                },
                "type": "object"
            },
            "MovieDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Movie"
                    },
                    {
                        "properties": {
                            "synopsis": {
                                "type": "string",
                                "example": "Un ex-agente infiltrado debe detener una conspiración global..."
                            },
                            "director": {
                                "type": "string",
                                "example": "María Castillo"
                            },
                            "screenings": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Screening"
                                }
                            }
                        },
                        "type": "object"
                    }
                ]
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "Sanctum",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Admin",
            "description": "Admin"
        },
