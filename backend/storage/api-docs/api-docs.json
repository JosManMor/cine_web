{
    "openapi": "3.0.0",
    "info": {
        "title": "Cine Sendera API",
        "description": "API REST para el sistema de gestión de cine Cine Sendera. Autenticación vía Bearer Token (Sanctum).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api",
            "description": "Servidor principal"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Registro de usuario",
                "description": "Crea una cuenta nueva con rol 'client' y devuelve un Bearer Token. Envía un correo de verificación automáticamente.",
                "operationId": "f367ea894b2ac44a9607f8e0a9a03537",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Juan Pérez",
                                        "maxLength": 255
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123",
                                        "minLength": 8
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario registrado correctamente",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|abc123..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Inicio de sesión",
                "description": "Autentica al usuario y devuelve un Bearer Token. Rate limit: 5 intentos por minuto.",
                "operationId": "ec9c379d2a959de66404708dd4a9322d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Autenticación exitosa",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "2|xyz789..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciales incorrectas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Credenciales incorrectas."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Datos inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Cierre de sesión",
                "description": "Revoca el Bearer Token actual.",
                "operationId": "cc14526f9abd470d63047b1c05aef0c3",
                "responses": {
                    "200": {
                        "description": "Sesión cerrada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Sesión cerrada correctamente."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/email/verification-notification": {
            "post": {
                "tags": [
                    "Verificación de correo"
                ],
                "summary": "Reenviar correo de verificación",
                "description": "Envía un nuevo enlace firmado al correo del usuario autenticado. Rate limit: 6 por minuto.",
                "operationId": "2f359547288bf415a228a2a2dbb74a9d",
                "responses": {
                    "200": {
                        "description": "Correo enviado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Correo de verificación enviado."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "204": {
                        "description": "Correo ya verificado (sin cuerpo)"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/email/verify/{id}/{hash}": {
            "get": {
                "tags": [
                    "Verificación de correo"
                ],
                "summary": "Verificar correo electrónico",
                "description": "Valida el enlace firmado recibido por email y marca el correo como verificado.",
                "operationId": "74298087f7abdea2982e5a7ea970428f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID del usuario",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "hash",
                        "in": "path",
                        "description": "SHA-1 del email",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "expires",
                        "in": "query",
                        "description": "Timestamp de expiración",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "signature",
                        "in": "query",
                        "description": "Firma HMAC",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Correo verificado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Correo verificado correctamente."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Firma inválida o expirada"
                    },
                    "401": {
                        "description": "No autenticado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/movies": {
            "get": {
                "tags": [
                    "Cartelera"
                ],
                "summary": "Listar cartelera",
                "description": "Devuelve todas las películas con estado activo, ordenadas por título.",
                "operationId": "5ea1e205d16b53f29174a23fd2dc0aca",
                "responses": {
                    "200": {
                        "description": "Lista de películas activas",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Movie"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/movies/{id}": {
            "get": {
                "tags": [
                    "Cartelera"
                ],
                "summary": "Detalle de película",
                "description": "Devuelve la película con sus funciones (solo status=open), salas y asientos disponibles calculados.",
                "operationId": "4705b96c2d4c7ae2c3d1138291da5b6d",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Película con funciones",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MovieDetail"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Película no encontrada"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "User": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Juan Pérez"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "juan@example.com"
                    },
                    "role": {
                        "type": "string",
                        "example": "client",
                        "enum": [
                            "admin",
                            "cashier",
                            "client"
                        ]
                    }
                },
                "type": "object"
            },
            "ValidationError": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "The name field is required."
                    },
                    "errors": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "Movie": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Inferno Nexus"
                    },
                    "genre": {
                        "type": "string",
                        "example": "Acción"
                    },
                    "duration_minutes": {
                        "type": "integer",
                        "example": 138
                    },
                    "rating": {
                        "type": "string",
                        "example": "PG-13"
                    },
                    "poster_url": {
                        "type": "string",
                        "format": "uri",
                        "example": "https://cine-sendera.com/images/inferno-nexus.jpg"
                    },
                    "status": {
                        "type": "string",
                        "example": "active",
                        "enum": [
                            "active",
                            "inactive"
                        ]
                    }
                },
                "type": "object"
            },
            "Room": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Sala 1"
                    },
                    "total_seats": {
                        "type": "integer",
                        "example": 120
                    },
                    "available_seats": {
                        "type": "integer",
                        "example": 48
                    }
                },
                "type": "object"
            },
            "Screening": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 12
                    },
                    "start_time": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-07-25T14:00:00Z"
                    },
                    "format": {
                        "type": "string",
                        "example": "2D",
                        "enum": [
                            "2D",
                            "3D",
                            "IMAX"
                        ]
                    },
                    "language_type": {
                        "type": "string",
                        "example": "subtitled",
                        "enum": [
                            "dubbed",
                            "subtitled",
                            "original"
                        ]
                    },
                    "base_price": {
                        "type": "number",
                        "format": "float",
                        "example": 90
                    },
                    "status": {
                        "type": "string",
                        "example": "open",
                        "enum": [
                            "open",
                            "closed",
                            "cancelled"
                        ]
                    },
                    "room": {
                        "$ref": "#/components/schemas/Room"
                    }
                },
                "type": "object"
            },
            "MovieDetail": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Movie"
                    },
                    {
                        "properties": {
                            "synopsis": {
                                "type": "string",
                                "example": "Un ex-agente infiltrado debe detener una conspiración global..."
                            },
                            "director": {
                                "type": "string",
                                "example": "María Castillo"
                            },
                            "screenings": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Screening"
                                }
                            }
                        },
                        "type": "object"
                    }
                ]
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "Sanctum",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticación",
            "description": "Autenticación"
        },
        {
            "name": "Verificación de correo",
            "description": "Verificación de correo"
        },
        {
            "name": "Cartelera",
            "description": "Cartelera"
        }
    ]
}